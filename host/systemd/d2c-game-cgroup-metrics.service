[Unit]
Description=Read-only per-match SRCDS cgroup metrics
After=k3s.service
[Service]
ExecStart=/usr/bin/python3 /root/game-cgroup-metrics.py
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=10%
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
PrivateTmp=true
[Install]
WantedBy=multi-user.target
